# FastAPI Backend Environment Variables
PROJECT_NAME="GymAI API"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Security & CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY="change_this_to_a_secure_secret_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# Database Configuration
DATABASE_URL="postgresql://gym_ai_user:gym_ai_password@localhost:5432/gym_ai_db"

# Local dev test account (created for UI checks; local DB only)
DEV_TEST_EMAIL=
DEV_TEST_PASSWORD=

# Meal Snap (food photo recognition). Free key: https://aistudio.google.com/apikey
# Leave empty to use manual food entry only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# WhatsApp Coach (Meta WhatsApp Cloud API): see docs/whatsapp-coach.md. Leave empty to keep it off;
# without WHATSAPP_TOKEN replies are written to the log instead of sent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BOT_NUMBER=
