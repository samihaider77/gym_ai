# FastAPI Backend Environment Variables
PROJECT_NAME="GymAI API"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Security & CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY="change_this_to_a_secure_secret_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# Database Configuration
DATABASE_URL="postgresql://gym_ai_user:gym_ai_password@localhost:5432/gym_ai_db"

# Local dev test account (created for UI checks; local DB only)
DEV_TEST_EMAIL=
DEV_TEST_PASSWORD=
