# Root Environment Variables Template

# Project Configuration
PROJECT_NAME=GymAI
ENVIRONMENT=development

# Database Settings (PostgreSQL)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=gym_ai_user
POSTGRES_PASSWORD=gym_ai_password
POSTGRES_DB=gym_ai_db

# Backend Ports & Ports Mapping
BACKEND_PORT=8000

# Frontend Ports
FRONTEND_PORT=3000
