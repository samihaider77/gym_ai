# Where the backend API lives (no trailing slash).
BACKEND_URL=http://127.0.0.1:8000/api/v1
# Same value as WHATSAPP_GATEWAY_SECRET in backend/.env. Make it long and random.
GATEWAY_SECRET=
# Status and login-QR page. Keep HOST=127.0.0.1 on your PC. On a server, set HOST=0.0.0.0 and a QR_PAGE_TOKEN,
# then open /qr?token=<QR_PAGE_TOKEN>. Whoever scans that QR controls the bot, so never share the link.
HOST=127.0.0.1
PORT=3100
QR_PAGE_TOKEN=
# Login session files. On a server this folder must be on a persistent disk, or you scan the QR after every deploy.
AUTH_DIR=./auth
